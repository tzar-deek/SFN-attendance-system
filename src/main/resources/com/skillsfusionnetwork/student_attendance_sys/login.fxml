<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<AnchorPane prefHeight="700.0" prefWidth="1200.0" stylesheets="@styles.css" styleClass="root-pane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.skillsfusionnetwork.student_attendance_sys.LoginController">
    <children>
        <!-- Top Navigation -->
        <HBox alignment="CENTER_LEFT" layoutX="60.0" layoutY="40.0" spacing="15.0">
            <ImageView fitHeight="36.0" fitWidth="36.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@images/fingerIcon.png"/>
                </image>
            </ImageView>
            <VBox>
                <Label text="SFN" styleClass="logo-title" />
                <Label text="ATTENDANCE SYSTEM" styleClass="logo-subtitle" />
            </VBox>
        </HBox>

        <!-- Center Login Card Container -->
        <VBox alignment="CENTER_LEFT" layoutX="320.0" layoutY="100.0" prefWidth="560.0" spacing="15.0" styleClass="scanner-card">
            <padding>
                <Insets top="40.0" right="50.0" bottom="40.0" left="50.0"/>
            </padding>
            <children>
                <Label text="SFN ADMINISTRATOR PORTAL" styleClass="step-indicator" />
                <Label text="Welcome back" styleClass="main-heading" />
                <Label text="Sign in to manage programs and attendance." styleClass="sub-heading" wrapText="true" />

                <Label text="Username or ID" styleClass="sub-heading" style="-fx-font-size: 12px;" />
                <TextField fx:id="usernameField" promptText="admin123" prefHeight="40.0" maxWidth="Infinity" />

                <Label text="Password" styleClass="sub-heading" style="-fx-font-size: 12px;" />
                <StackPane alignment="CENTER_RIGHT" prefHeight="40.0" maxWidth="Infinity">
                    <children>
                        <PasswordField fx:id="passwordField" promptText="••••••••" prefHeight="40.0" maxWidth="Infinity" />
                        <TextField fx:id="visiblePasswordField" promptText="••••••••" prefHeight="40.0" maxWidth="Infinity" visible="false" managed="false" />
                        <Button fx:id="togglePasswordBtn" text="👁" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 0 10 0 0; -fx-font-size: 16px;" focusTraversable="false" StackPane.alignment="CENTER_RIGHT" />
                    </children>
                </StackPane>

                <Button fx:id="loginButton" text="Sign in to dashboard  >" prefHeight="40.0" maxWidth="Infinity" styleClass="primary-button" />

                <Label fx:id="errorLabel" textFill="#2bff6c" styleClass="error-label" />

                <HBox alignment="CENTER" spacing="5.0" style="-fx-padding: 10px 0 0 0;" maxWidth="Infinity">
                    <children>
                        <Label text="New to SFN?" styleClass="sub-heading" />
                        <Hyperlink fx:id="gotoRegisterLink" text="Create an account" styleClass="skip-link" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>